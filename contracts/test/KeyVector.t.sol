pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";

/// @notice Cross-stack pin: the TypeScript canonical key/hash derivation in
/// @dev      src/server/chain/keys.ts must agree byte-for-byte with Solidity
///           ABI encoding. Vectors below were generated by the backend
///           (campaignKeyFor / policyHashFor) for this exact fixture:
///           campaignId 11111111-2222-4333-8444-555555555555, version 1,
///           target 5, budget 15000000, floor 2000000, ceiling 4000000,
///           minPurchase 10000000, deadline 2026-12-31T23:59:59.999Z,
///           visibility PUBLIC, refundHold 0, empty rules objects,
///           wallet 0x000000000000000000000000000000000000A11C.
contract KeyVectorTest is Test {
    bytes32 constant EXPECTED_KEY = 0xf88a7b0f88c7ebd8d446255ca8d28f2fc0eb449d297cd03493c09914100904ff;
    bytes32 constant EXPECTED_HASH = 0x9525fd1fd9b4bb4dc765a39d43fbb9f3513df62431e0aa8e57766311a46569ba;

    function test_campaignKey_matchesBackend() public pure {
        bytes32 key =
            keccak256(abi.encode("thesma:campaign", "11111111-2222-4333-8444-555555555555", uint256(1)));
        assertEq(key, EXPECTED_KEY);
    }

    function test_policyHash_matchesBackend() public pure {
        bytes32 emptyRules = keccak256("{}");
        bytes32 hash = keccak256(
            abi.encode(
                "thesma:policy:v1",
                "11111111-2222-4333-8444-555555555555",
                uint256(1),
                uint256(5),
                uint256(15_000_000),
                uint256(2_000_000),
                uint256(4_000_000),
                uint256(10_000_000),
                uint256(1_798_761_599), // 2026-12-31T23:59:59Z
                "PUBLIC",
                uint256(0),
                emptyRules,
                emptyRules,
                address(0x000000000000000000000000000000000000a11c)
            )
        );
        assertEq(hash, EXPECTED_HASH);
    }
}
