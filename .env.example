# Provider-neutral Postgres boundary.
# Point at any Postgres (local, Neon, Supabase, Docker). Do NOT couple domain code to a provider.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thesma_dev

# Opaque session cookie name (optional override)
# SESSION_COOKIE_NAME=thesma_session

# ---- Arc environments (mainnet + Canteen testnet) ----
# Thesma settles on Arc Mainnet in production (chain ID 5042).
# The Canteen Arc Testnet (chain ID 5042002) is for hackathon
# development, agent testing, test-USDC workflows and safe demos only.
# Production NEVER switches to testnet: ARC_NETWORK defaults to mainnet,
# and each environment reads only its own variables (no silent fallback).
# NEVER commit real RPC URLs/tokens or private keys. Placeholders only.
# Mainnet = production. Select explicitly; unset means mainnet.
# ARC_NETWORK=mainnet
# Existing production contract (unchanged):
# ARC_CHAIN_ID=
# ARC_RPC_URL=
# Canteen testnet overrides (read ONLY when ARC_NETWORK=testnet):
# ARC_TESTNET_RPC_URL=
# ARC_TESTNET_CHAIN_ID=5042002
# ARC_TESTNET_USDC_ADDRESS=
# ARC_TESTNET_VAULT_ADDRESS=
# ARC_TESTNET_EXPLORER_BASE_URL=
# Separate testnet operator wallet (never the production keys):
# ARC_TESTNET_OPERATOR_ADDRESS=
# ARC_TESTNET_OPERATOR_PRIVATE_KEY=
# ARC_TESTNET_VERIFIER_ADDRESS=
# Shared contract/identity vars below apply to MAINNET unless a testnet
# override above is set. The owner signs funding from their own browser
# wallet; the backend only prepares unsigned transactions and verifies
# receipts.
# Arc USDC (defaults to 0x3600000000000000000000000000000000000000 when unset)
# ARC_USDC_ADDRESS=
# ThesmaMarketVault deployment (unset until deployed; doctor reports accordingly)
# THESMA_VAULT_ADDRESS=
# Executor + verifier identities bound into created campaigns
# THESMA_EXECUTOR_ADDRESS=
# THESMA_VERIFIER_ADDRESS=
# Optional explorer base URL for receipt links
# ARC_EXPLORER_BASE_URL=

# ---- Referral attribution (S3) ----
# HMAC secret for signed first-party attribution tokens. Minimum 32 chars.
# Missing/short secret fails closed (referral route returns 503).
# Never expose client-side, never log.
# ATTRIBUTION_SECRET=

# ---- Purchase verifier (S4) ----
# Server-only bearer secret for POST /internal/checkout/:id/verify.
# Minimum 16 chars. Missing/short fails closed (503). Never expose client-side.
# VERIFIER_INTERNAL_SECRET=

# ---- Automatic payout worker (S5) ----
# Server-only bearer secret for POST /internal/payouts/*.
# Falls back to VERIFIER_INTERNAL_SECRET when unset. Minimum 16 chars.
# PAYOUT_WORKER_SECRET=

# ---- Background Supply Agent worker ----
# Server-only bearer secret for POST /internal/agents/supply/run.
# Minimum 16 chars. Vercel Cron uses GET with CRON_SECRET instead.
# SUPPLY_AGENT_WORKER_SECRET=

# ---- Background Creator Scout worker ----
# Server-only bearer secret for POST /internal/agents/scout/run.
# Minimum 16 chars. Vercel Cron uses GET with CRON_SECRET instead.
# SCOUT_WORKER_SECRET=
# Shared Vercel Cron bearer for GET /internal/* (payouts, supply, scout).
# Minimum 16 chars. Vercel injects CRON_SECRET automatically when Cron is enabled.
# CRON_SECRET=
# Server-only signing keys (local-key adapters for test/dev).
# Each MUST derive to its configured address (THESMA_VERIFIER_ADDRESS /
# THESMA_EXECUTOR_ADDRESS) or construction fails closed. Never NEXT_PUBLIC,
# never logged, never returned by APIs.
# THESMA_VERIFIER_PRIVATE_KEY=
# THESMA_EXECUTOR_PRIVATE_KEY=
